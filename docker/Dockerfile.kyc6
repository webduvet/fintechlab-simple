# syntax=docker/dockerfile:1
FROM docker.io/library/golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kyc6 ./cmd/kyc6

FROM docker.io/library/alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/kyc6 /usr/local/bin/kyc6
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/kyc6"]
