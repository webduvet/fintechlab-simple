# deploy/aws/lab.sh reads deploy/aws/lab.env (copy this file; it is
# gitignored). Variables set in the environment win over this file.
# Nothing here is secret, but it is yours: addresses and an account id.

# Which AWS credentials and where. Leave AWS_PROFILE empty for the default
# chain (aws sso login, environment variables).
AWS_PROFILE=
AWS_REGION=eu-west-1

# Refuse to run against any other account -- worth setting when the account
# holds other workloads too.
LAB_ACCOUNT_ID=

# The stack's name. Two stacks with different names are two independent labs.
LAB_STACK=fintechlab-dev

# Who may reach the lab is an allowlist people edit -- 'lab.sh allow' adds
# your address, 'lab.sh deny' removes one, 'lab.sh allowed' lists them
# (docs/deploy-cloud.md). This only seeds it: comma-separated CIDRs added at
# 'lab.sh infra' when missing, never removed. Empty is fine: the console is
# then 'lab.sh console' (an SSM port forward) until someone is allowed.
LAB_ALLOWED_CIDRS=

# How many addresses each list holds. The allowlist opens everything a
# platform needs (vendors, console, lab API, SFTP) and is named by three of
# the security group's rules; the console list opens the console and the
# vendors' pages only (8080-8094: the lab API through the console's /v1) and
# is named by one. So 3 x LAB_ALLOWLIST_SIZE + LAB_CONSOLE_LIST_SIZE must fit
# the security group's 60 rules. 0 makes no console list; 'lab.sh allow
# --console' adds to it.
LAB_ALLOWLIST_SIZE=20
LAB_CONSOLE_LIST_SIZE=0

# The name the lab is reached at. Empty: its Elastic IP, which is stable for
# the life of the stack. With LAB_HOSTED_ZONE_ID (a Route 53 public zone you
# own) the stack writes the A record; without it, point the name at the
# PublicIp output yourself. Changing it after the first deploy needs new
# certificates: REGENERATE_KEYS=true lab.sh deploy.
LAB_DOMAIN=
LAB_HOSTED_ZONE_ID=

# More names the lab's certificates carry, comma-separated DNS:<name> or
# IP:<address> -- say a name in a zone someone else runs, which works the
# moment its record points at the lab. Like LAB_DOMAIN, changing it after the
# first deploy needs new certificates.
LAB_SANS=

# The platform's webhook and callback hosts, comma-separated -- added to every
# vendor's webhook allowlist, so Banking Circle and B4B may call them.
LAB_WEBHOOK_ALLOW=

# Per-container overrides, space-separated container.KEY=value: callback
# targets the lab dials itself, delivery delays. For example
#   LAB_SET="aci.ACI_WEBHOOK_TARGET_URL=https://hooks.example.com/aci"
LAB_SET=

# The platform's seeder image, built in the platform's own repository
# (lightyear: pnpm nx run lab-seeder:container:podman -> localhost/lightyear/lab-seeder:dev),
# shipped in the bundle and run in the lab's pod: it seeds an environment's
# databases and writes settlement files for its merchants. Empty: no seeder.
LAB_SEEDER_IMAGE=

LAB_INSTANCE_TYPE=t3.small

# cloud (the default): no lab clock -- for a deployed platform, which cannot
# follow one. local: with the clock, for a runner on your machine that does
# (lab.sh tunnel carries its callbacks). Redeploy to switch.
LAB_PROFILE=

# The lab API's token is not set here: the host makes one on the first
# deploy and keeps it with the lab's state. 'lab.sh token' prints it;
# ROTATE_TOKEN=true lab.sh deploy replaces it.
